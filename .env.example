# Укажите свой адрес. Для разработки без Caddy подойдет http://localhost:8080.
PUBLIC_ORIGIN=https://write.example.org
KARETKA_OWNER_LOGIN=alchemist308
# SHA-256 одноразового кода активации (64 шестнадцатеричных знака).
KARETKA_OWNER_SETUP_HASH=
KARETKA_DATA_VOLUME=karetka_data
# Метка локального Docker-образа. Перед сборкой можно передать git commit через окружение.
KARETKA_RELEASE=local

# off, test или live. Для теста используйте отдельную установку и тестовый магазин.
BILLING_MODE=off
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# manual_npd или provider. Для provider нужен RECEIPT_VAT_CODE.
RECEIPT_MODE=
RECEIPT_VAT_CODE=
# Для включения продаж заполните данные продавца и опубликованные документы.
SELLER_NAME=
SUPPORT_EMAIL=
OFFER_URL=
PRIVACY_URL=
